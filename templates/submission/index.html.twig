{% extends 'base.html.twig' %}
{% block title %}Submission
{% endblock %}
{% block container_title %}Submissions
{% endblock %}
{% block body %}
	<!-- testFilter.html.twig -->


	<div class="row">
		<div class="col-lg-10">


			<h5 class='text-info'>
				{{ info |raw}}</h5>
			<div class="table-responsive">

				<table class="table  table-bordered table-striped table-responsive">
					<thead>
						<tr>
							<th>#</th>
							<th>Title</th>
							<th>Category</th>
							<th>Researcher(PI)</th>
							<th>Submission Date</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						{% for submission in submissions %}
							<tr {% if submission.complete=='completed' %} class='text-' {% elseif submission.complete==''%} class='text-danger' {% endif %}>
								<td>{{ loop.index  }}</td>
								<td>{{ submission.title }}</td>

								<td class='text-center'>
									<span class="label label-{% if submission.submissionType=='Mega research' %}success{% elseif submission.submissionType=='Grant'%}info{% elseif submission.submissionType=='Technology transfer'%}primary{% elseif submission.submissionType=='Community service'%}warning{% elseif submission.submissionType==''%}default{% endif %}">{{ submission.submissionType }}</span>
								</td>
								<td>{{ submission.author.email }}</td>
								<td>
									{% if submission.sentAt %}
										{{ submission.sentAt|date() }}
									{% endif %}
								</td>
								<td nowrap="nowrap">
									{% if app.user.id==submission.author.id  %}
										<span class="badge bg-success">You are the author</span>
										<a href="{{ path('submission_status', {'id': submission.id}) }}" class='btn btn-primary btn-xs mb-1'>
											Status</a>

									</a>

								{% else %}
									<a href="{{ path('review_assignment_new', {'id': submission.id}) }}" class='btn btn-primary btn-xs mb-1'>Assign Reviewer</a>

									{% if   submission.complete=='' %}
										<a href="" class='badge bg-danger   mb-1'>Incomplete
										</a>
								{% else %}

									<a href="{{ path('submission_show', {'id': submission.id}) }}" class='btn btn-primary btn-xs mb-1'>Show</a>
									{% endif %}

								{% endif %}
								{% if app.user.id==submission.author.id and submission.complete=='' %}
									<a href="{{ path('submission_firststep_edit', {'id': submission.id}) }}" class='btn btn-primary btn-xs mb-1'>Finish
									</a>
								{% endif %}
							</tr>
						</td>
					</tbody>
				</tr>
			{% else %}
				<tr>
					<td colspan="8">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div></div><div class="col-lg-2">
<div class="ibox">
	<h4 class='text-info'>Quick Filter<h4>
			<div class="row container   mb-3">
				<a href="{{ path('submission_filter', {'filter': 'al'}) }}" class='btn btn-primary btn-xs mb-1 btn-block'>All
				</a>
				<a href="{{ path('submission_filter', {'filter': 'cp'}) }}" class='btn btn-primary btn-xs mb-1 btn-block'>Complete
				</a>
				<a href="{{ path('submission_filter', {'filter': 'mg'}) }}" class='btn btn-warning btn-xs mb-1 btn-block'>Mega</a>
				<a href="{{ path('submission_filter', {'filter': 'cs'}) }}" class='btn btn-primary btn-xs mb-1 btn-block'>Community
				</a>

				<a href="{{ path('submission_filter', {'filter': 'gr'}) }}" class='btn btn-primary btn-xs mb-1 btn-block'>Grant
				</a>
				<a href="{{ path('submission_filter', {'filter': 'tt'}) }}" class='btn btn-primary btn-xs mb-1 btn-block'>TT
				</a>
				<a href="{{ path('submission_filter', {'filter': 'ps'}) }}" class='btn btn-primary btn-xs mb-1 btn-block'>Published
				</a>
				<a href="{{ path('submission_filter', {'filter': 'ap'}) }}" class='btn btn-info btn-xs mb-1 btn-block'>Approved
				</a>
				<a href="{{ path('submission_filter', {'filter': 'ap'}) }}" class='btn btn-danger btn-xs mb-1 btn-block'>Rejected
				</a>
				<a href="{{ path('submission_filter', {'filter': 'rv'}) }}" class='btn btn-warning btn-xs mb-1 btn-block'>Review assigned</a>

				<p>

					<div class="text-center  "></div>
				</p>
			</div>
		</div>
	</div>

	<div class="navigation">
		{{ knp_pagination_render(submissions) }}
	</div>
</div>{% endblock %}
