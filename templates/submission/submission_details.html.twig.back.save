{% extends 'base.html.twig' %}

{% block title %}Submission
{% endblock %}
{% block container_title %}Submission detail
{% endblock %}
{% block body %}
	<div class="row">
		<div class="col-lg-9">

			<h4>Project progress
			</h4>

			{{ include('submission/progress.html.twig') }}


			<div class="row">
				<div class="col-lg-12">
					<dl class="row mb-0">
						<div class="col-sm-2 text-sm-right">
							<dt>
								{% if submission.sentAt %}
									{{ submission.sentAt|date() }}
								{% endif %}
							</dt>
							<span class="label label-{% if submission.submissionType=='mega' %}success {% elseif submission.submissionType=='grant'%}info{% elseif submission.submissionType=='technology'%}primary{% elseif submission.submissionType=='community'%}warning{% endif %}">{{ submission.submissionType }}</span>
						</div>
						<div class="col-sm-9 text-sm-left">
							<dd>
								<div class="nowrap">
									<div style="width: 100%;" class="text-success strong">
										<h5 class="font-16 m-0 fw-bold">
											{{ submission.Title }}:{{ submission.subTitle }}

										</h5>
									</div>
								</div>
								<small>
									{{ submission.author }}
								</small>
							</dd>
						</div>
						<div class="col-sm-1 text-sm-left">
							<dd>
								<div class="nowrap">
									<div style="width: 100%;" class="text-success strong">

										<a class="badge bg-primary" href="{{ path('research_sumary', {'uid': submission.uidentifier }) }}">
											PDF
											<i class="fa fa-download"></i>
										</a>


									</div>
								</div>
							</dd>
						</div>
					</dl>
				</div>
			</div>
			<div class="row m-t-sm">
				<div class="col-lg-12">
					<div class="panel blank-panel">
						<div class="panel-heading">
							<div class="panel-options">
								<ul class="nav nav-tabs">
									<li>
										<a class="nav-link active" href="#tab-1" data-bs-toggle="tab">Research detail</a>
									</li>
									<li>
										<a class="nav-link" href="#tab-2" data-bs-toggle="tab">Revision</a>
									</li>
									<li>
										<a class="nav-link" href="#tab-3" data-bs-toggle="tab">Discussion</a>
									</li>
								</ul>
							</div>
						</div>

						<div class="panel-body">

							<div class="tab-content">
								<div class="tab-pane active" id="tab-1">
									<div class="row">
										<div class="col-md-12">

											<div class="ibox">

												<div class="ibox-content">


													<div class="table-responsive">
														<table class="table shoping-cart-table">

															<tbody>
																<tr>

																	<td class="desc">
																		<h3>
																			<a href="#" class="text-navy">
																				Executive summary
																			</a>
																		</h3>
																		<p class="medium">

																			{{ submission.abstract |raw}}
																		</p>
																		<div class="m-t-sm">
																			<a href="#" class="text-muted">Keywords:
																			</a>
																			{{ submission.keywords}}
																		</div>
																		<h3>
																			Background
																		</h3>
																		<p class="medium">

																			{{ submission.BackgroundAndRationale |raw}}
																		</p>

																		<h3>
																			Methodology
																		</h3>
																		<p class="medium">

																			{{ submission.methodology |raw}}
																		</p>
																		<h3>
																			Research Outcome
																		</h3>
																		<p class="medium">

																			{{ submission.ResearchOutcome |raw}}
																		</p>

																		<h3>
																			Reference
																		</h3>
																		<p class="medium">

																			{{ submission.Reference |raw}}
																		</p>


																		{{ submission.submissionType}}

																		<hr>


																	</td>


																</tr>
															</tbody>
														</table>
													</div>
													<hr>
													<h4 class='text-'>Research team</h4>
													<table class="table table-striped">
														<thead>
															<tr>
																<th>#</th>
																<th>Name</th>
																<th>Affiliation</th>
																<th>Email</th>
																<th>Role</th>

															</tr>
														</thead>
														<tbody>
															<tr class='text-primary'>
																<td>1</td>
																<td>
																	<a href='{{path('researcher',{'id':submission.author.id})}}'>
																		{% if submission.author.userInfo is defined %}
																			{{ submission.author.userInfo }}
																		{% else %}
																			{{ submission.author.email }}
																			(
																			{{ submission.author.username }}
																			)
																		{% endif %}
																	</a>

																</td>
																<td>{{ submission.author.userInfo.affiliation }}</td>
																<td>{{ submission.author.email }}</td>
																<td>PI</td>

															</tr>
															{% for co_author in  submission.coAuthors %}
																<tr>
																	<td>{{ loop.index }}</td>
																	<td>{{ co_author.name }}
																		<a href='{{path('researcher',{'id':co_author.researcher.id})}}'>


																			{% if co_author.researcher.userInfo  is defined %}
																				{{ co_author.researcher.userInfo  }}
																			{% else %}
																				{{ co_author.researcher.email }}
																			{% endif %}
																		</a>
																	</td>
																	{# <td>{{ co_author.role }}</td> #}
																	<td>{{ co_author.Department }}</td>
																	<td>{{ co_author.email }}</td>
																	<td>{{ co_author.role }}</td>

																</tr>
															{% else %}
																<tr>
																	<td colspan="7">No contributers added</td>
																</tr>
															{% endfor %}
														</tbody>
													</table>
													{# <h4 class='text-success'>Budget details</h4> #}
													<hr>
													{% if submission.submissionType=='Grant' %}
														<h4 class='text-info'>Grant won  details</h4>
														<table class="table">
															<thead>
																<tr>
																	<th>#</th>
																	<th>Name</th>
																	<th>Amount won</th>
																	<th>Description</th>
																	<th>actions</th>
																</tr>
															</thead>
															<tbody>
																{% for collaborating_institution in collaborating_institutions %}
																	<tr>
																		<td>{{ loop.index }}</td>
																		<td>{{ collaborating_institution.name }}</td>
																		<td>{{ collaborating_institution.amountgranted }}</td>
																		<td>{{ collaborating_institution.description }}</td>
																		<td>
																			<a href="{{ path('collaborating_institution_show', {'id': collaborating_institution.id}) }}">show</a>

																		</td>
																	</tr>
																{% else %}
																	<tr>
																		<td colspan="4">no records found</td>
																	</tr>
																{% endfor %}
															{% else %}
																<h4 class='text-'>Action paln</h4>
																{% if submission.actionplan|length >0  %}

																	{{  submission.actionplan |raw }}
																</tbody>
															</table>
												 

												{% endif %}

												<h5 class='text-'>Budget breakdown</h5>
												<table class="table table-striped">
													<thead>
														<tr>
															<th>#</th>
															<th>Expense category</th>
															<th>Cost
															</th>
															<th>Quantity
															</th>
															<th>Description
															</th>
															<th>Remark
															</th>
															{# <th>Approve </th> #}
														</tr>
													</thead>
													<tbody>
														{% for expense in expenses %}
															<tr>
																<td>{{ loop.index }}</td>
																<td>{{ expense.category }}</td>

																<td>{{ expense.cost }}</td>
																<td>{{ expense.quantity }}</td>
																<td>{{ expense.description }}</td>
																<td>{{ expense.remark }}</td>
																{# <td>{{ expense.approvedexpense }}</td> #}
																{# {% set tot=expense.cost*expense.quantity %} #}
															</tr>
															{# {{tot}} #}=
														{% else %}
															<tr>
																<td colspan="3">no records found</td>
															</tr>
														{% endfor %}
														<tr class='text-success strong'>{# <td colspan='5'>
														Grand Total  	</td>  #}
															{# <td colspan='1'></td> #}
															{# <td>{{ Overall_budger_request.Totalapproved }}</td> #}

														</tr>
													</tbody>
												</table>
											{% endif %}

											<div class="table-responsive">
												{% if submission.researchTimeTables|length >0 %}

													<h4>Time table :
													</h4>

													<table class="table table-bordered">

														<thead>
															<tr class="bg-gray-dark">
																<th>Task</th>

																<th>Date Start</th>

																<th>Date End</th>
																<th>Remark</th>
															</tr>
														</thead>
														<tbody>
															{% for schedule in submission.researchTimeTables %}
																<tr>
																	<td>{{ schedule.task }}</td>
																	<td>
																		{{ schedule.DateStart|date('d M Y ') }}
																	</td>
																	<td>
																		{{ schedule.DateEnd|date('d M Y') }}
																	</td>
																	<td>{{ schedule.remark }}</td>


																</tr>
																{% else %}

															{% endfor %}


														</tbody>
													</table>
													{% else %}
												{% endif %}

											</div>

										</div>

									</div>
								</div>

							</div>
						</div>


					</div>

				</div>

			</div>
		</div>


		<div class="tab-pane" id="tab-2">


			{% for review in reviews %}

				<table class="table shoping-cart-table">

					<tbody>
						<tr>
							<td class="desc">

								<p class="small">

									{{ review.comment |raw}}
								</p>
								<dl class="small m-b-none">
									<dt>Revised at
										{{ review.CreatedAt ?
                                                        review.CreatedAt|date('Y-m-d H') : '' }}
									</dt>
								</dl>

								<div class="m-t-sm">

									{% if review.attachment %}
										<a href="{{ asset('/files/proposals/review_files/'~ review.attachment ) }}" class="badge bg-info mt-2">
											Download review file
											<i class="fa fa-download material-icons  "></i>
										</a>
									{% else %}
										<span class="label label-danger">
											{% trans %}No attachement found{% endtrans %}
										</span>
									{% endif %}
								</div>
							</td>
							<td width="65" nowrap="nowrap">
								<h4 class='text-primary'>
									Review :
									{{ loop.index }}
								</h4>
								{{ review.remark |raw}}
								<hr>
								{% if review.AllowToView=='' %}

									<a href="{{ path('allocomment', {'id': review.id}) }}" class="btn btn-primary" onsubmit="return confirm('Are you sure you want to sendcommentto PI ?');">
										Send   comment to PI</a>


								{% elseif review.AllowToView=='1'  %}
									<a class="btn btn-success">
										Comment sent to PI</a>
									{% else %}

								{% endif %}

								<hr>
								{# {{editorialDecisions.decision}} #}
							</td>
						</tr>
					</tbody>
			{% else %}
					{# <tr>
																																																																																																										 																																																				                                    </tr> #}
				</table>
			{% endfor %}


			<hr>
			{{ form_start(adminvevisionform) }}
			{{ form_widget(adminvevisionform) }}
			<button class="btn btn-primary">{{ button_label|default('Submit Review') }}</button>
			{{ form_end(adminvevisionform) }}
		</div>
		<div
			class="tab-pane" id="tab-3">{# {{ submission.abstract |raw }} #}
		</div>
	</div>
</div></div></div></div><div class="col-lg-3"><div class="card"><div class="card-body ">
<h4 class="font-18 m-0 fw-bold">Attachments:</h4><br>
{% for submissionattachment in submission.submissionAttachements %}
	<a href="{{ asset('/uploads/submission/'~ submissionattachment.file ) }}" class="btn btn-info btn-xs float-right">
		{{submissionattachment.name}}
		<i class="fa fa-download material-icons warning"></i>
	</a>
{% else %}
	<span class="label label-danger">
		{% trans %}No attachement found{% endtrans %}</span>
{% endfor %}</div></div><div class="card"><div class="card-body ">
<h4 class="font-18 m-0 fw-bold">Co-PI confirmation:</h4><br>
{% for member in submission.coAuthors %}
	{{loop.index}}{# {{member.researcher}} #}<a href='{{path('researcher',{'id':member.researcher.id})}}'>
		{{ member.researcher.userInfo }}</a>
	{% if member.confirmed=='1' %}
		<i class="fa fa-check text-success"></i>
	{% elseif member.confirmed==''    %}
		<i class="fa fa-times-circle text-danger"></i>


		{# {% elseif member.confirmed=='0'    %}  <i class="fa fa-close text-danger"></i>      #}
	{% else  %}
		<i class="fa fa-close text-danger"></i>
	{% endif %}<br>{% else %}No Co-PI has been involved
{% endfor %}</div></div><div class="card"><div class="card-body ">
<h5 class="font-18 m-0 fw-bold">Reviewers</h5><hr>
{% for review_assignment in review_assignments %}
	<h4 class="m-0 fw-semibold text-dark font-16 mt-3">
		{{ review_assignment.reviewer }}


		{{ review_assignment.ExternalreviewerName }}</h4>
	<p class="text-muted  mb-0 font-13">
		<span class="text-dark">
			Invitation Sent At:
			{{ review_assignment.InvitationSentAt ? review_assignment.InvitationSentAt|date('Y-m-d H:i') : '' }}
		</span>

		<span class="text-dark">
			Review duedate:
			{{ review_assignment.duedate ? review_assignment.duedate|date('Y-m-d') : '' }}
		</span>
	</p>
	<div class="row mt-4 d-flex align-items-center">
		<div class="col">
			<h5 class="font-16 m-0 fw-bold">{{ loop.index }}</h5>
			<p
				class="mb-0 text-muted">
				{# {% if review_assignment.status == 1 %}
																																																																																																										<span class="badge bg-info" title="Invitation not sent">Selected</span>
																																																																																																									{% elseif  review_assignment.status == 2 %}
																																																																																																										<span class="badge bg-primary">Invitation Sent</span>
																																																																																																									{% elseif  review_assignment.status == 3 %}
																																																																																																										<span class="badge bg-primary">Reviewing</span>
																																																																																																		
																																																																																																									{% endif %} #}

				{% if review_assignment.ExternalreviewerEmail  %}
					<span class="badge bg-primary">External reviewer</span>
				{% else %}
					<span class="badge bg-success">Internal reviewer</span>
				{% endif %}
				<hr>
				{# {{ include('review_assignment/_delete_form.html.twig') }} #}
				<form method="post" action="{{ path('review_assignment_delete', {'id': review_assignment.id}) }}" onsubmit="return confirm('Are you sure you want to unassign{{review_assignment.reviewer }} from reviewers list?');">
					<input type="hidden" name="_method" value="DELETE">
					<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ review_assignment.id) }}">
					<button class="btn btn-danger btn-xs">
						<i class="ace-icon fa fa-attachement">
							Unassign</i>
					</button>


				</form>

				<script src="{{ asset('ui/js/jquery.min.js') }}"></script>
			</p>
		</div>
	</div>
	{% else %}No reviewers has been assigned yet<a href="{{ path('review_assignment_new', {'id': submission.id}) }}" class='btn btn-primary btn-xs mb-1'>Assign Reviewer</a>
{% endfor %}</div></div></div></div>{% endblock %}
