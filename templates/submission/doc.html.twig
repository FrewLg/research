{% extends 'base.html.twig' %}
{% block title %}
	Submission
{% endblock %}
{% block styles %}
	<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css"/>
{% endblock %}
{% block container_title %}
	Submissions
{% endblock %}
{% block body %}
	<!-- testFilter.html.twig -->

	<style>
		.highlight {
			background-color: yellow;
		}
	</style>
	<hr>
	<div class="row">

		<div class="col-lg-9">

			<div class="card ">
				<div class="card-header container">
					Blid Submission Checking
				</div>

				<div class="card-body container ">


					<div class="table-responsive" id="inputText">
						<div id="playground">

							<form>
								<p>Highlight keywords as you type:
									<input id="keywords" type='textarea' width='100%' height='200px;'></p>
							</form>

							<p>
								{{ document |raw}}</p>

						</div>


					</div>

				</div>
			</div>
		</div>
		<div class="col-lg-3">
			<div class="card ">
				<div class="card-header  ">
					<b>Result</b>
				</div>
				<div class="card-body container ">
					<div class="row ">
						{{result}}
						<hr class="hr-dashed my-4">
						<b>
							Appearance:
							{{count}}</b>
						<hr class="hr-dashed my-4">
						 	<ol class='m-2'>
								<li class='text-primary'>
									
									<a href='{{path('researcher',{'id':submission.Author.id})}}'  class='text-primary' >
											{{submission.Author}} [PI]</a>
								</li>
								{% for member in submission.coAuthors %}
									<li>
										<a href='{{path('researcher',{'id':member.researcher.id})}}'>
											{{ member.researcher.userInfo }}</a>

										{% if member.confirmed=='1' %}
											<i class="fa fa-check text-success"></i>
										{% elseif member.confirmed==''    %}
											<i class="fa fa-times-circle text-danger"></i>

										{% else  %}
											<i class="fa fa-close text-danger"></i>
										{% endif %}<br>
									</li>
									{% else %}No Co-PI has been involved
								{% endfor %}
							</ol>  
					</div>

				</div>
			</div>
		</div>
	{% endblock %}
	{% block script %}
		<script src="{{ asset('plugins/select2/hilitor.js')}}"></script>

		<script src="hilitor.js"></script>
		<script>

			window.addEventListener("DOMContentLoaded", function (e) {
var myHilitor2 = new Hilitor("playground");
myHilitor2.setMatchType("left");
document.getElementById("keywords").addEventListener("keyup", function (e) {
myHilitor2.apply(this.value);
}, false);
}, false);
		</script>
	{% endblock %}
