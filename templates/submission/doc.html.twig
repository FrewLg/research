{% extends 'base.html.twig' %}
{% block title %}
	Submission
{% endblock %}
{% block styles %}
	<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css"/>
{% endblock %}
{% block container_title %}
	Submissions
{% endblock %}
{% block help_right %}
	{% include "helps/submission_help.html.twig" %}

{% endblock %}
{% block body %}
	<!-- testFilter.html.twig -->

	<style>
		.highlight {
			background-color: yellow;
		}
	</style>
	<hr>
	<div class="row">

		<div class="col-lg-9">

			<div class="card ">
				<div class="card-header container">
					<b>Blind Submission Checking
					</b>
				</div>

				<div class="kanban-board m-0">


					<div class="kanban-col ">
						<div class="kanban-main-card">
							<div class="kanban-box-title">
								<h4 class="font-14  ">Highlight keywords as you type:</h4>
								<form>

									<input id="keywords" type='textarea' placeholder='Enter keyword' class='form-control'></p>
							</form>


						</div>

						<div class="card  ">
							<div class="card-body">

								<div class="table-responsive">
									<div id="playground">
										<p>
											{{ document |raw}}</p>

									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>

	</div>
	<div class="col-lg-3">
		<div class="card ">
			<div class="card-header  ">
				<b>Result</b>
			</div>
			<div class="card-body container ">
				<b>{{result}}
				</b>
				<hr class="hr-dashed my-4">
				<b>
					Research team member's name appearance count:
					{{count}}</b>
			</div>

		</div>

		<div class="card ">
			<div class="card-header  ">
				<b>Research team</b>
			</div>
			<div class="card-body container ">
				<div class="row ">

					<button class="btn btn-xs btn-outline-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">Help</button>


					<hr class="hr-dashed my-4">
					<ol class='m-2'>
						<li class='text-primary'>

							<a href='{{path('researcher',{'id':submission.Author.id})}}' class='text-primary'>
								{{submission.Author}}
								[PI]</a>
						</li>
						{% for member in submission.coAuthors %}
							<li>
								<a href='{{path('researcher',{'id':member.researcher.id})}}'>
									{{ member.researcher.userInfo }}</a>

								{% if member.confirmed=='1' %}
									<i class="fa fa-check text-success"></i>
								{% elseif member.confirmed==''    %}
									<i class="fa fa-times-circle text-danger"></i>

								{% else  %}
									<i class="fa fa-close text-danger"></i>
								{% endif %}<br>
							</li>
							{% else %}No Co-PI has been involved
						{% endfor %}
					</ol>
				</div>
			</div>
		</div>

		<div class="card ">
			<div class="card-header  ">
				<b>Decision</b>
			</div>
			<div class="card-body container ">
				<a href="{{ path('review_assignment_new', {'id': submission.id}) }}" class='  btn btn-sm btn-soft-primary btn-xs   '>
					Assign  Reviewer</a>
				<hr class="hr-dashed my-4">
				<button type="button" class="btn btn-block btn-soft-danger btn-sm">Decline</button>
				<button type="button" class="btn btn-block btn-soft-success btn-sm">Select for shortlist</button>

			</div>

		</div>

	</div>
{% endblock %}
{% block script %}
	<script src="{{ asset('plugins/select2/hilitor.js')}}"></script>

	<script src="hilitor.js"></script>
	<script>

		window.addEventListener("DOMContentLoaded", function (e) {
var myHilitor2 = new Hilitor("playground");
myHilitor2.setMatchType("left");
document.getElementById("keywords").addEventListener("keyup", function (e) {
myHilitor2.apply(this.value);
}, false);
}, false);
	</script>
{% endblock %}
