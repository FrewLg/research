{% block breadcrumb %}
	<li class="breadcrumb-item active">Profile</li>
{% endblock %}
{% block body %}
	
<script>

		
		window.onload = function() {
        document.getElementById('publication_article_document').style.display = 'none';
    }
 function attachOrDoi() {
	 
	if (document.getElementById('noCheck').checked) {
 	document.getElementById('publication_doi').style.display = 'block';
 	document.getElementById('publication_article_document').style.display = 'none';

 	} else {

  	document.getElementById('publication_doi').style.display = 'none';
 	document.getElementById('publication_article_document').style.display = 'block';

 	}
	}
		</script>

	Yes
	<input type="radio" onclick="attachOrDoi();" name="yesno" id="doi"/>

	No
	<input type="radio" onclick="attachOrDoi();" name="yesno" id="noCheck"/>

	<br>

	<input   id='yes' name='yes' placeholder='If yes, explain:'/>
 
 	<input    id='other4' name='other4' placeholder='other 4'>
