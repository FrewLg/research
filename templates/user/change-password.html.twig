{% extends 'base.html.twig' %}

{% block title %}Change password
{% endblock %}
{% block container_title %}   Change password
{% endblock %}
{% block body %}

	<div class="card">
		<div class="card-header">
			<h5>Change password
			</h5>
		</div>
		<div class="card-body">


			{{ form_start(form) }}
			{{ form_widget(form) }}

			<button class="btn btn-primary float-right">{{ button_label|default('Update password') }}</button>
			{{ form_end(form) }}

		</div>
	</div>

{% endblock %}
