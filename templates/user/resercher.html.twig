{% extends 'base.html.twig' %}

{% block title %}Edit Profile{% endblock %}
{% block container_title %}Profile{% endblock %}
 {% block pagehead %}  Profile {% endblock %}
{% block breadcrumb %} <li class="breadcrumb-item active">Profile</li>  {% endblock %} 
{% block body %}
 
<div class="row m-b-lg m-t-lg ">
                <div class="col-md-6">

                    <div class="profile-image">
 
                                   {% if user.image is defined %}
                   <img src="{{ asset('files/profile_pictures/'~user.image ) }}" class="rounded-circle circle-border m-b-md" alt="profile">
                                       {% else %}
                               <img src="{{ asset('/img/defaultuser.png') }}" class="rounded-circle circle-border m-b-md" alt="profile">
                                    {% endif %}
                    </div>
                    <div class="profile-info">
                        <div class="">
                            <div>
                                <h2 class="no-margins">
                                     {{ user.suffix }}
   {% if user.firstName is defined %}
                                   
                                    {{ user.firstName }}
                                    {% else %}
                                    {% endif %}
                                    
                                   {% if user.midleName is defined %}
                                   
                                    {{ user.midleName }}
                                    {% else %}
                                    {% endif %}
 
                                   {% if user.lastName is defined %}
                                   
                                    {{ user.lastName }}
                                    {% else %}
                                    {% endif %}
                                   
                                    
                                </h2>
                                <h4>  {% if user.affiliation is defined %}
                                   
                                    {{ user.affiliation }}
                                    {% else %}
                                    {% endif %} </h4>
                                <small>
                                    {% if user.bio is defined %}
                                   
                                    {{ user.bio |raw}}
                                    {% else %}
                                    {% endif %} 
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <table class="table small m-b-xs">
                        <tbody>
                        <tr>
                            <td>
                                <strong>Tel:</strong> {{ user.phoneNumber }}
                            </td>
                            <td>
                                <strong>Gender:</strong> {{ user.gender }}
                            </td>

                        </tr>
                        <tr>
                            <td>
                                <strong>Email:</strong> {{ user.email }}
                            </td>
                            <td>
                                <strong>Address</strong>  {{ user.address }}
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong> Affiliation: </strong> {{ user.affiliation }}
                            </td>
                            <td>
                                 <strong> Affiliation: </strong> {{ user.affiliation }}
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-3">
                    <small class='text-success'> <b> {{ totalSubmissions }} Research submissions </b></small>                     
     
    
                </div>


            </div>
             
 
 <div class="col-lg-12">
                    <div class="tabs-container">
                        <ul class="nav nav-tabs" role="tablist">
                            <li><a class="nav-link active show" data-toggle="tab" href="#tab-list"> Personal info </a></li>
                            <li><a class="nav-link" data-toggle="tab" href="#tab-researches">Researches </a></li>
                             <li><a class="nav-link" data-toggle="tab" href="#tab-subscriptions">Subscriptions </a></li>
                        
<li><a class="nav-link" data-toggle="tab" href="#tab-manage-user">Manage  User </a></li>
                                                     </ul>
                        <div class="tab-content">
                    
 <div role="tabpanel" id="tab-list" class="tab-pane active show">
                                <div class="panel-body">
 <table class="table table-striped">
         <tbody>
            <tr>
                <th>Suffix</th>
                <td>{{ user.Suffix }}</td>
            </tr>
            
            <tr>
                <th>Full name</th>
                <td>{{ user.firstName }} {{ user.midleName }} {{ user.lastName }}</td>
            </tr>
            <tr>
                <th>Username</th>
                <td>{{ user.username }}</td>
            </tr>
            <tr>
                <th>Gender</th>
                <td>{{ user.gender }}</td>
            </tr>
            <tr>
                <th>Affiliation</th>
                <td>{{ user.affiliation }}</td>
            </tr>
        </tbody>
    </table>

                                </div>
                            </div>
                            
                           <div role="tabpanel" id="tab-researches" class="tab-pane">
                                <div class="panel-body">
        <div class="row">                                
        <div class="col-md-4">
                    <h4 class='text-success'>Submissions</h4>
                    
                    <table class="table table-striped"> 
        <thead>
            <tr>
 
                <th>Research </th>
                  <th>Publication </th> 
            </tr>
        </thead>
        <tbody>
        {% for usersubmission in usersubmissions %}
            <tr>
            <td>
                {{ usersubmission.research }}
                 </td>
                 <td>{{ usersubmission.Submissions }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">No submission has been made yet</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
                    </div>
                     <div class="col-md-4">
                    <h4 class='text-success'>Reviews</h4>
                    
                    <table class="table table-striped"> 
        <thead>
            <tr>
 
                <th>Research </th>
                                <th>Publication </th> 
            </tr>
        </thead>
        <tbody>
        {% for userpublication in userpublication %}
            <tr>
 
   <td>
                {{ userpublication.Subbmission_type }}
                 </td>
                                 <td>{{ userpublication.Proposals }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">No reviews has been made yet</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
       </div> 
               <div class="col-md-4">
                    <h4 class='text-success'>Publications</h4>
                    
                    <table class="table table-striped"> 
        <thead>
            <tr>
 
                <th>Research </th>
                                <th>Publication </th> 
            </tr>
        </thead>
        <tbody>
        {% for userpublication in userpublication %}
            <tr>
 
   <td>
                {{ userpublication.Subbmission_type }}
                 </td>
                                 <td>{{ userpublication.Proposals }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">No publication has been made yet</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
       </div> 
       
              </div> 
                                </div>
                            </div>
                               <div role="tabpanel" id="tab-subscriptions" class="tab-pane">
                                <div class="panel-body">

{% for subscription in subscriptions %}
                                          <table class='table table-striped' >
                                            <tr>
  <td>
                Announcements: {% if subscription.announcement=='1'%} <span class='text-success'>Subscribed</span> {% else %} <span class='text-danger'>Not subscribed</span>  {% endif %}
                 </td>
                     <tr>
  <td>
               News: {% if subscription.news=='1'%} <span class='text-success'>Subscribed</span> {% else %} <span class='text-danger'>Not subscribed</span>  {% endif %}
                 </td>
     <tr> <td>
               New Submissions: {% if subscription.newSubmission=='1' %} <span class='text-success'>Subscribed</span>  {% else %}  <span class='text-danger'>Not subscribed</span>  {% endif %}
                 </td>
                    <tr>
                    <td>New call for proposal announcement:{% if subscription.calls=='1' %}  <span class='text-success'>Subscribed</span>  {% else %} <span class='text-danger'>Not subscribed</span>  {% endif %}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">You havent subscribed yet</td>
            </tr>
        {% endfor %}
</table>
              
               <hr>
 
                                </div>
                            </div>
                            
                            
                            <div role="tabpanel" id="tab-manage-user" class="tab-pane">
                                <div class="panel-body">
 

                                </div>
                            </div>
                       </div>
                    </div>
                </div>
                
{% endblock %}
