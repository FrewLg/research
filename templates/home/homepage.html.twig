	{% endblock %}


	{% block aside %}
{% if is_granted('ROLE_USER') %}
{% else  %}
 
		<div class="card  wow fadeInLeft animated p-3 active" style="visibility: visible; animation-name: fadeInLeft;">
			<div class="card-body p-0 auth-header-box">
				<div class=" p-3">

					<h4 class="">Sign in</h4>
				</div>
			</div>
			<div
				class="card-body p-0">

				<!-- Tab panes -->
				<div class="tab-content">
					<div class="tab-pane p-3 active" id="LogIn_Tab" role="tabpanel">
 {# <div class="wow fadeInLeft animated p-3 active" style="visibility: visible; animation-name: fadeInLeft;"> #}

						<form method="post" class="form-group" action={{ path('app_login') }}>
							{% if error is defined and error %}

								<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
							{% endif %}

							{% if app.user %}
								<div class="mb-3">
									You are logged in as
									{{ app.user.username }},
									<a href="{{ path('app_logout') }}">Logout</a>
								</div>
							{% endif %}

							<!-- <h5 class="h5 mb-3 font-weight-normal">Please sign in here if you have an account</h5> -->
							<label for="inputUsername">Username</label>
							<input type="text" value="" name="email" placeholder='Email' id="inputUsername" class="form-control" autocomplete="email" required autofocus>
							<label for="inputPassword">Password</label>
							<input type="password" name="password" id="inputPassword" placeholder='Password' class="form-control" autocomplete="current-password" required>

							<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">


							<div class="form-group row my-3">
								<div class="col-sm-12">
									<div class="custom-control custom-switch switch-success">
										<input type="checkbox" class="custom-control-input" name='_remember_me' id="customSwitchSuccess">
										<label class="form-label text-muted" for="customSwitchSuccess">Remember me</label>
									</div>
								</div>
								<!--end col-->
								<div class="col-sm-12 text-end">
									<a href="{{ path('app_forgot_password_request')}}" class="text-muted font-13">
										<i class="fa fa-lock"></i>
										Forgot password?</a>
								</div>
								<!--end col-->
							</div>
							<!--end form-group-->


							<div class="col-12">
								<button class="btn btn-primary w-100 waves-effect waves-light" type="submit">Login
									<i class="fa fa-lock "></i>
								</button>
							</div>
				 
						</form>

						<div class="m-3 text-center text-muted">
							<p class="mb-0">Don't have an account ?
								<a href="{{ path('app_register')}}" class="text-primary ms-2">SignUp here</a>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
{% endif  %}


	{% endblock %}
