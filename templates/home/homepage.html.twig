{% extends 'homelayout.html.twig' %}
{% block breadcrumb %}{% endblock %}
{# {% block pagehead %}Home
{% endblock %} #}
{% block title %}Home
{% endblock %}


{% block body %}

	{#% include 'page_includes/header_report.html.twig'%#}

	<meta property="og:url" content="http://127.0.0.1:8000/call-for-proposals/45c6511210cb942387708990398a8bf9/details"/>
	<meta property="og:type" content="JU"/>
	<meta property="og:title" content="RMS Announcemen ts"/>
	<meta property="og:description" content="Your description"/>
	<meta property="og:image" content="http://127.0.0.1:8000/call-for-proposals/45c6511210cb942387708990398a8bf9/details"/>


	<h4>
		Recent call for proposals</h4>

	{% for call_for_proposal in call_for_proposals %}

		<article class="col-lg-9"> 
							 
							<small>
							{{ call_for_proposal.postDate ? call_for_proposal.postDate|date('Y-m-d H:s') : '' }}
							</small> 
							<h6 class="">

								<a href="{{ path('call_for_proposal_show', {'uidentifier': call_for_proposal.uidentifier }) }}">
							 

								<p  style="font-family:arial; text-align:justify;">	{{ call_for_proposal.subject|striptags|slice(0, 170)|raw }}</p>
								</a>
							</h6> 
				 
					 
				 </article>


		{% else %}

			<td colspan="7">No calls made yet</td>

		{% endfor %}


		<div class="pagination-block">
			<div class="navigation">
				{{ knp_pagination_render(call_for_proposals) }}
			</div>

		</div>
		{% if  announcements|length > 0 %}
			<h4>
				Recent announcements</h4>

			{% for call_for_proposal in announcements %}

				<article
					class="col-lg-9 post ttm-blog-classic clearfix">
				 

					<div class="ttm-blog-classic-content">
						<div class="ttm-post-entry-header">
							<div class="post-meta">
								<small class="ttm-meta-line ">
									 
							 {{ call_for_proposal.posetedAt ? call_for_proposal.posetedAt|date('Y-m-d H:s') : '' }}
								 
								</small>
							</div>
							 

									<a href="{{ path('announcement_show', {'id': call_for_proposal.id }) }}">
										{{ call_for_proposal.subject |raw}}

									</a>
							 
						</div>
						 
					</div>
				</article>
			{% endfor %}


		{% endif %}
		<div class="pagination-block">
			<div class="navigation">
				{{ knp_pagination_render(announcements) }}
			</div>

		</div>


