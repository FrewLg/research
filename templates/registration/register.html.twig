<div class="tab-content" id="pills-tabContent">
  <div class="tab-pane fade  " id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab">{{ form_start(registrationForm) }}
						
							{{ form_row(registrationForm.username, {
            label: 'Username'
        }) }}
		
			<div class="form-group">
                            
								{{form_row(registrationForm.email,{"attr":{"class":"form-control"}})}}
							</div>

							{{ form_row(registrationForm.password, {
            label: 'Password'
        }) }}
							{{ form_row(registrationForm.agreeTerms) }}

							<button type="submit" class="btn btn-info btn-block">Register</button>
							{{ form_end(registrationForm) }}</div>
  <div class="tab-pane fade" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab">	{{ form_start(uas_form) }}
							{{form_errors(uas_form)}}
							<div class="form-group">
								{{form_row(uas_form.username)}}
							</div>
							<div class="form-group">
								{{form_row(uas_form.password)}}
							</div>


							{{ form_row(uas_form.agreeTerms) }}

							<button type="submit" class="btn btn-info btn-block">Sign Up</button>
	<br>
 	
							{{ form_end(uas_form) }}


						 
</div>
 
</div>

 Already have an account?<a href='{{ path('app_login')}}' class='text-info' > Login  </a>
		 
	 
	 

 
{% endblock %}
{% block scripts %}
<script>
    
{% if  is_external  %}
    $('#pills-home').addClass("active show");
    $('#pills-home-tab').addClass("active");
      $('#pills-profile').removeClass("active show");
    $('#pills-profile-tab').removeClass("active");
{% else %}

    $('#pills-home').removeClass("active show");
    $('#pills-home-tab').removeClass("active");
    $('#pills-profile').addClass("active show");
    $('#pills-profile-tab').addClass("active");
    
{% endif %}
</script>
    
{% endblock %}
 