{% extends 'base.html.twig' %}

{% block title %}Board Members
{% endblock %}
{% block maintitle %}Board Members
{% endblock %}

{% block body %}
	<div
		class="row">
		{# <div class="card-body row"> #}
		{% if is_granted('mng_brd_mbr') %}


			<div class="col-3">
				<div class="card">
					<div class="card-header ">
						<h6>Register new Board Member</h6>

					</div>
					<div class="card-body row">
						{{ include('board_member/_form.html.twig') }}
					</div>
				</div>
			</div>
			<div class="col-8 ">
			{% else %}
				<div class="col-12">

				{% endif %}
				<div class="card">
					<div class="card-header ">
		 <h6 class=" d-inline">Board Members List(Total:-{{board_members.totalItemCount}})
						</h6>
					</div>
					<div class="card-body ">


					<form action="" class="float form-horizontal flex-column form-inline ">
						
						<input class='form-control col-6' type="search" name="search" value="{{app.request.query.get('search')}}" class=" d-inline " placeholder="Search">

					</form>
<br>
					<table class="table table-striped table-bordered">
						<thead>
							<tr>
								<th>#</th>
								<th>Name</th>
								<th>College</th>
								<th>Assigned At</th>
								<th>Status</th>
								{% if  is_granted('mng_brd_mbr') %}

									<th>actions</th>
								{% endif %}
							</tr>
						</thead>
						<tbody>
							{% for board_member in board_members %}
								<tr>
									<td>{{ loop.index }}</td>

									<td>{{ board_member.user }}</td>
									<td>{{ board_member.college }}</td>
									<td>{{ board_member.assignedAt ? board_member.assignedAt|ago : '' }}</td>
									<td>{{ board_member.statusText }}</td>
									{% if  is_granted('mng_brd_mbr') %}

										<td>
											{{ include('board_member/_delete_form.html.twig') }}
										</td>
									{% endif %}
								</tr>
							{% else %}
								<tr>
									<td colspan="4">no records found</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>

				</div>
				<div class="float-right" id="custompag	inator">{{ knp_pagination_render(board_members) }}</div>

			</div>
		</div>
	{% endblock %}
