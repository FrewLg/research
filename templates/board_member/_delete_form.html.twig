<form method="post" action="{{ path('board_member_delete', {'id': board_member.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ board_member.id) }}">
    <button class="btn btn-danger btn-sm">Remove</button>
</form>
