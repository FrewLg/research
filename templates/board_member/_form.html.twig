{{ form_start(form) }}
<div class="row">
	<div class="form-group col-4">
        	<label>{{ form_label(form.user) }}</label>
		{{ form_widget(form.user) }}
	</div>
	<div class="form-group col-4    ">
			<label>{{ form_label(form.college) }}</label>
		{{ form_widget(form.college) }}
	</div>
	<div class="form-group col-4">
			<label>{{ form_label(form.role) }}</label>
            {{ form_widget(form.role) }}
	</div>
</div>

<button class="btn btn-success float-end col-3">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
