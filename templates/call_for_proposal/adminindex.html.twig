{% extends 'base.html.twig' %}
{% block title %}Calls
{% endblock %}
{% block container_title %}Calls
{% endblock %}

{% block header_contenttwo %}

	{% if is_granted('modify_call_pr') %}

		<a href="{{ path('call_for_proposal_new') }}" class='btn btn-primary btn-sm'>
			Make a new call for proposal</a>
	{% endif %}

{% endblock %}


{% block body %}

	<div class="row">
		<div class="col-lg-6">
			<ul class="list-inline">
				<li class="list-inline-item">
					<h5 class="mt-0">Here the list of all  call for proposal.
						<span class="badge badge-pink">6</span>
					</h5>
				</li>
			</ul>
		</div>
		<!--end col-->

		<div class="col-lg-6 text-end">
			<div class="text-end">
				<ul class="list-inline">

					<li class="list-inline-item">
						<button type="button" class="btn btn-soft-primary btn-sm">
							<i class="fas fa-filter"></i>
						</button>
					</li>
					<li class="list-inline-item">
						<a href="{{ path('call_for_proposal_new') }}" class="btn btn-soft-primary btn-sm">Add New call for proposal</a>
					</li>
				</ul>
			</div>
		</div>
		<!--end col-->
	</div>

	<div class="row">
		<div class="col-lg-12">
			<div class="card">
				<div class="card-header">
					<div class="row align-items-center">
						<div class="col">
							<h4 class="card-title">
								All call for papers
							</h4>
							Total: ({{call_for_proposals.totalItemCount}})

						</div>
						<!--end col-->
						<div class="col-auto">

							{% if is_granted('modify_call_pr') %}

								<a href="{{ path('call_for_proposal_new') }}" class='btn btn-primary btn-sm'>
									Make a new call for proposal</a>
							{% endif %}

						</div>
						<!--end col-->
					</div>

					{# <a href="{{ path('submission_firststepold', {'uidentifier': call_for_proposal.uidentifier}) }}"  class="dropdown-item">[test]Submit proposal</a> #}

					<!--end row-->
				</div>
				<!--end card-header-->
				<div class="card-body">
					<div class="table-responsive browser_users table-bordered">

						<div class="table-responsive">

							<table class="table table-bordered table-striped table-responsive">
								<thead>
									<tr>
										<th>#</th>
										<th>Call name</th>
										<th>Post date</th>
										<th>Deadline</th>
										<th>Action</th>
									</tr>
								</thead>
								<tbody>
									{% for call_for_proposal in call_for_proposals %}
										<tr>
											<td>{{ loop.index  }}</td>
											<td>{{ call_for_proposal.heading |raw }}</td>
											<td>
												{{ call_for_proposal.postDate ? call_for_proposal.postDate|date('Y-m-d H:i') : '' }}
											</td>
											<td class='text-center'>
												{{ call_for_proposal.deadline ? call_for_proposal.deadline|date('Y-m-d H:i') : '' }}
											</td>
											<td nowrap="nowrap">
												<a href="{{ path('call__details', {'id': call_for_proposal.id }) }}" title='Show details' class='btn btn-soft-success btn-sm'>
													<i class='fas fa-eye '></i>
												</a>
												{% if is_granted('mng_rprts') and call_for_proposal.researchReportPhase %}

													<a href="{{ path('call_research_reports', {'id': call_for_proposal.id }) }}"  title='Reports' class='btn btn-soft-secondary btn-sm'>
													<i class='fas fa-chart-line '></i>	Reports 
													</a>
												{% endif %}
												{% if is_granted('modify_call_pr') %}

													<a href="{{ path('call__edit', {'id': call_for_proposal.id}) }}" title='Edit call' class="btn btn-sm btn-soft-primary"><i class='fas fa-pen '></i></a>
													<a href="{{ path('allawarded', {'id': call_for_proposal.id}) }}" class='btn btn-soft-primary btn-sm' title='Winners'>  <i class='fas fa-certificate '></i> </a>
												{% endif %}

												<a href="{{ path('callresponses', {'id': call_for_proposal.id }) }}" title='Call response' class='btn btn-soft-info btn-sm'>
												
												                                                                                        <i class='fas fa-paper-plane '></i> ({{call_for_proposal.submissions|length}})</a>
													<a href="{{ path('call_dashboard', {'id': call_for_proposal.id}) }}" class='btn btn-soft-primary btn-sm' title='Call Dashbord'><i class='fas fa-chart-bar '></i> </a>

<a href="{{ path('theme_by_coll', {'id': call_for_proposal.id }) }}" class='btn btn-soft-primary btn-xs btn-block' title='Show submissions by theme'>
													<i class='fas fa-chart-pie '></i> All by theme

													<span  class="avatar-box thumb-xxs align-self-center">
														<span class="avatar-title bg-soft-info rounded-circle font-13 font-weight-normal">
															{{call_for_proposal.submissions|length}}
														</span>

													</span>
												</a>

											</td>

										</tr>
									{% else %}
										<tr>
											<td colspan="8">no records found</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>

						<div class="navigation">
							{{ knp_pagination_render(call_for_proposals) }}
						</div>

						<!--end table-->
					</div>
					<!--end /div-->
				</div>
				<!--end card-body-->
			</div>
			<!--end card-->
		</div>
	</div>


{% endblock %}
