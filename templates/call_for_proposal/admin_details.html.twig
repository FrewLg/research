{% extends 'base.html.twig' %}

{% block title %}Call for proposal
{% endblock %}

{% block pagehead %}Call For Proposal
{% endblock %}
{% block breadcrumb %}
	<li class="breadcrumb-item active">Call For Proposal</li>
{% endblock %}
{% block body %}
	<div class="card">


		<div class="card-body ">
			<div class="row ">
				<div class="col-md-6 col-lg-3">
					<div class="card report-card">
						<div class="card-body">
							<div class="row d-flex justify-content-center">
								<div class="col">
									<p class="text-dark mb-0 fw-semibold">Submissions</p>
									<h3 class="m-0">{{ call_for_proposal.submissions|length}}
										PIs</h3>
									<p class="mb-0 text-truncate text-muted">
										<span class="text-success">
											{{0}}
											Co-PIs</span>
									</p>
								</div>
								<div class="col-auto align-self-center">
									<div class="report-main-icon bg-light-alt">
										<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-clock align-self-center text-muted icon-sm">
											<circle cx="12" cy="12" r="10"></circle>
											<polyline points="12 6 12 12 16 14"></polyline>
										</svg>
									</div>
								</div>
							</div>
						</div>
						<!--end card-body-->
					</div>
					<!--end card-->
				</div>
			</div>
            	<div class="row align-items-center">
						<div class="col">
							<h4 class="card-title">Proposals destribution by thematic areas
								<button id="btn-theme" class="btn btn-soft-success btn-sm">
									<i class="fa fa-download material-icons  "></i>
								</h4>
							</div>
							<!--end col-->
						{# ds #}
							<!--end col-->
						</div>
					</div>
					<!--end card-header-->
					<div class="card-body">
						<div class="" style="position: relative;">
							<div id="ana_dash_1" class="apex-charts" style="min-height: 335px;"></div>
							<canvas id="bar-chart" width="400" height="200"></canvas>


						</div>
					</div>
				</div>
		</div>
	</div>
	<div class="card">


		<div class="card-body ">
			<div class="social-feed-box p-4">
				<div class="float-right ">


					Date:<u>
						{{ call_for_proposal.postDate ? call_for_proposal.postDate|date('Y-m-d H:i:s') : '' }}</u>
					<br>
				</div>
				<div>
					{% if is_granted('modify_call_pr') and call_for_proposal.approved=='1' %}
						<a href="{{ path('call_approve_undo', {'id': call_for_proposal.id }) }} " class='btn btn-success btn-xs'>
							Unpublish
						</a>
						{% if is_granted('mng_rprts') %}

							<a href="{{ path('call_research_report_phase', {'id': call_for_proposal.id }) }}" class='btn btn-success btn-xs'>
								Report Setting
							</a>
						{% endif %}
						<a href="{{ path('template_and_form_index', {'id': call_for_proposal.id }) }}" class='btn btn-secondary btn-xs'>
							Templates and forms
						</a>

					{% else %}
						<a href="{{ path('call__approve', {'id': call_for_proposal.id }) }}" class='btn btn-warning btn-xs'>
							Approve and publish</a>
					{% endif %}


					<a href="{{ path('callresponses', {'id': call_for_proposal.id }) }}" class='btn btn-info btn-xs'>

						Responses</a>
					<a href="{{ path('call_approved_result', {'uidentifier': call_for_proposal.uidentifier }) }}" class='btn btn-success btn-xs'>

						Result</a>
					<a href="{{ path('calsendbatch_email', {'uidentifier': call_for_proposal.uidentifier }) }}" class='btn btn-soft-info btn-xs' onsubmit="return confirm('Are you sure you want to send batch email?');">

						Email shortlisted</a>

					<a href="{{ path('submission_firststepold', {'uidentifier': call_for_proposal.uidentifier}) }}" class='btn btn-primary btn-xs'>[test]Submit proposal</a>


				</div>
				<p>
					<div class="text-center  ">
						<br>
						<h5>
							<b>
								{{ call_for_proposal.heading |raw}}</b>
						</h5>

					</div>

					<span class="label label text-default">
						<b>{{ call_for_proposal.researchType}}
						</b>
						&nbsp;</span>
					<small>
						<span class="label label text-info">{{ call_for_proposal.views}}
							Views</span>
						{% for applicants in number_of_applicants %}
							<span class="label label text-info">{{ applicants.Proposals}}
								Applicant
								{% if applicants.Proposals >1 %}s
								{% endif %}
							</span>
						{% else %}
							<span class="label label text-info">
								Be the first applicant for this call!</span>

						{% endfor %}
					</small>
					<h6 style="text-align: justify;"><br>{{ call_for_proposal.subject|raw }}</h6>
					<h5 class='text-info'>Thematic areas
						<h5>
							<ol>
								{% if call_for_proposal.thematicArea %}
									{% for themes in call_for_proposal.thematicArea %}

										<li>
											<h6>{{ themes.name }}</h6>
										</li>

									{% endfor %}
								{% endif %}
							</ol>

							<h5 class='text-info '>Please submit your proposal following this guideline:-
								<h5>
									<h6 style="text-align: justify;">
										{{ call_for_proposal.guidelines|raw }}
									</6>
								</p>
								<ul>
									<li>
										Submission Deadline :
										{{ call_for_proposal.deadline ? call_for_proposal.deadline|date('Y-m-d H:i:s') : '' }}
									</li>

									<li>
										Commitment from other research:
									</li>

									<li>
										Review process: starts at
										{{ call_for_proposal.reviewProcessEnd ? call_for_proposal.reviewProcessEnd|date('Y-m-d H:i:s') : '' }}
										and ends at
										{{ call_for_proposal.reviewProcessEnd ? call_for_proposal.reviewProcessStart|date('Y-m-d H:i:s') : '' }}
									</li>
									<li>
										Reviewers decision will be communicated at
										{{ call_for_proposal.reviewersDecisionWillBeCommunicatedAt ? call_for_proposal.reviewersDecisionWillBeCommunicatedAt|date('Y-m-d H:i:s') : '' }}
									</li>
									<li>
										Project starts on:
										{{ call_for_proposal.ProjectStartsOn ? call_for_proposal.ProjectStartsOn|date('Y-m-d H:i:s') : '' }}
									</li>
								</ul>
								<b>Principal contact addresses :</b>
								<br>
								<small>
									{% if call_for_proposal.college %}
										{{ call_for_proposal.college.name|raw }}
										<h5 class='text-center text-info'>
											<b>
												{{ call_for_proposal.college.name }}</b>

											<h6>
											{% else %}
												Center
												{% endif%}
											</small>
											<hr>
											<div class="row">
												<div class="col-md-6"></div>
												<div class="col-md-6">
													<div class="small text-right">
														{% if call_for_proposal.attachement %}

															<a class="badge bg-primary" href="{{ asset('files/guidelines/'~ call_for_proposal.attachement) }}">
																Download PDF
																<i class="fa fa-download"></i>
															</a>


															{% else %}
														{% endif %}
													</div>
												</div>
											</div>
										</div>
									</div>

								</div>

							{% endblock %}
