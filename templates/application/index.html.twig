{% extends 'base.html.twig' %}

{% block title %}Application index{% endblock %}

{% block body %}
<div class="card">
<div class="card-header">
									<h4 class="card-title">Application List</h4>
								
								</div>
                                <div class="card-body">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Project Type</th>
                <th>Submitted Date</th>
                <th>Status</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for application in applications %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ application.title }}</td>
                <td>{{ application.projectType }}</td>
                <td>{{ application.createdAt|date('Y-m-d h:i') }}</td>
          
                <td>
                {% if not application.status %}

            <span class="badge badge-soft-warning">Pending</span>
                {% endif %} 
                
                </td>
                <td>
                    <a class="btn btn-primary" href="{{ path('application_show', {'id': application.id}) }}">show</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
</div>
{% endblock %}
