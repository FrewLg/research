{% extends 'base.html.twig' %}

{% block title %}
  Application
{% endblock %}

{% block body %}
  <h1>
    Application
  </h1>
<a href={{ path('i_r_b_amendment_new',{id:application.id}) }}>Amendment</a>
  <div class="card">
    <h4>
      Title
    </h4>
    <h6>
      {{ application.title }}
    </h6>

    <h4>
      StartDate
    </h4>
    <h6>
      {{ application.startDate ? application.startDate|date('Y-m-d') : '' }}
    </h6>

    <h4>
      EndDate
    </h4>
    <h6>
      {{ application.endDate ? application.endDate|date('Y-m-d') : '' }}
    </h6>

    <h4>
      Location
    </h4>
    <h6>
      {{ application.location }}
    </h6>

    <h4>
      Description
    </h4>
    <h6>
      {{ application.description }}
    </h6>
  </div>








  <div class="modal fade bd-example-modal-lg" id="exampleModalLarge" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h6 class="modal-title m-0" id="myLargeModalLabel">Request Amendment</h6>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<!--end modal-header-->
			<div class="modal-body" id="modal-body">
			
            {% set application = form.vars.data.application %}
       
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <button class="btn">{{ button_label|default('Request') }}</button>
            {{ form_end(form) }}

			</div>
			<!--end modal-body-->
			<div class="modal-footer">
				<button type="button" class="btn btn-soft-secondary btn-sm" data-bs-dismiss="modal">Close</button>
			</div>
			<!--end modal-footer-->
		</div>
		<!--end modal-content-->
	</div>
	<!--end modal-dialog-->
</div>
<!--end modal-->


  <a href="{{ path('application_index') }}">back to list</a>

  {# {{ include('application/_delete_form.html.twig') }} #}
{% endblock %}
