{% macro displayObjective(objective) %}
	 
<div class="row grey">

	<div class="col-md-4">
		<div class="form-group select-wizard">
			<label class="bmd-label-floating">Task name</label>
			{{form_widget(objective.name)}}
		</div>
	</div>
	<div class="col-md-2">
		<div class="form-group select-wizard">
			<label class="bmd-label-floating">Start date</label>
			{{form_widget(objective.startDate)}}
		</div>
	</div>
	<div class="col-md-2">
		<div class="form-group select-wizard">
			<label class="bmd-label-floating">endDate</label>
			{{form_widget(objective.endDate)}}
		</div>
	</div>
	 
	<div class="col-md-1">
		<div class="form-group">

			<button type="button" class=" btn btn-danger btn-sm close  remove-collection-widget mt-4   bgc-h-danger-l2 radius-round ">
				<span aria-hidden="true">×</span>
			</button>
		</div>
	</div>
	</div>
{% endmacro %}

