{% extends 'base.html.twig' %}

{% block title %}CollaborativeResearchProject{% endblock %}

{% block body %}
    <h1>CollaborativeResearchProject</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ collaborative_research_project.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ collaborative_research_project.title }}</td>
            </tr>
            <tr>
