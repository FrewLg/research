{% extends 'base.html.twig' %}

{% block title %}Permission index{% endblock %}

{% block body %}
    <h1>Permission index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for permission in permissions %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ permission.name }}</td>
                <td>{{ permission.description }}</td>
                <td>
                    <a href="{{ path('permission_show', {'id': permission.id}) }}">show</a>
                    <a href="{{ path('permission_edit', {'id': permission.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
					<div class="navigation">{{ knp_pagination_render(permissions) }}</div>


    <a href="{{ path('permission_new') }}"  class='btn btn-primary btn-xs ' >Create new</a>
{% endblock %}
