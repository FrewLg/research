{% extends 'base.html.twig' %}

{% block title %}TrainingParticipant index{% endblock %}

{% block body %}
    <h1>TrainingParticipant index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Applied_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for training_participant in training_participants %}
            <tr>
                <td>{{ training_participant.id }}</td>
                <td>{{ training_participant.appliedAt ? training_participant.appliedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('training_participant_show', {'id': training_participant.id}) }}">show</a>
                    <a href="{{ path('training_participant_edit', {'id': training_participant.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('training_participant_new') }}">Create new</a>
{% endblock %}
