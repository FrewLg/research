{% extends 'base.html.twig' %}

{% block title %}Submission
{% endblock %}
{% block container_title %}Researches
{% endblock %}
{% block body %}
	<div class="row">
		<div class="pb-4">
			<ul class="nav-border nav nav-pills mb-0" id="pills-tab" role="tablist">
				<li class="nav-item">
					<a class="nav-link active" id="Profile_Project_tab" data-bs-toggle="pill" href="pages-profile.html#Profile_Project">Researches assigned to {{user.userInfo}} </a>
				</li>

			</ul>
		</div>
		<div class="row">
			<div class="col-12">
				<div class="tab-content" id="pills-tabContent">
					<div class="tab-pane fade active show" id="Profile_Project" role="tabpanel" aria-labelledby="Profile_Project_tab">

						<div class="row">

							<table class="table table-bordered">
								<thead>
									<tr>
										<th>#</th>
										<th>Title</th> 
										<th>Invitation sent date</th>
										<th>Invitation  due date</th>
										<th>Review due date</th> 
										<th>Response</th> 
										<th>Action</th>
									</tr>
								</thead>
								<tbody>
									{% for myreview in myreviews %}
										<tr>
											<td>{{ loop.index }}</td>
											<td>{{ myreview.submission.title }}</td>

											<td>
												{% if myreview.submission.sentAt %}
													{{
                                                myreview.submission.sentAt|date() }}
												{% endif %}
											</td>
                                            	<td>
												{% if myreview.invitationDueDate %}
													{{
                                                myreview.invitationDueDate|date() }}
												{% endif %}
											</td>

										 

											<td>
												{% if myreview.dueDate %}
													{{ myreview.dueDate|date() }}
												{% endif %}
											</td>
                                            <td>
  {{ myreview.Declined }} 
                                            
												{% if myreview.acceptedAt %}
												Accepted at:	{{ myreview.acceptedAt|date('d-m-y i:sa') }}
												{% endif %}
                                                	{% if myreview.rejectedAt %}
												Rejected at: 	{{ myreview.rejectedAt|date() }}
												{% endif %}

											</td>

											 
										</tr>
									{% else %}
										<tr>
											<td colspan="8">Not been  assigned to any subbmission yet!</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>

						</div>

					</div>
					<!--end row-->


				</div>


			</div>
		</div>
	</div>
{% endblock %}
