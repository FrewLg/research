{% extends 'base.html.twig' %}

{% block title %}ReviewAssignment index{% endblock %}

{% block body %}
    <h1>ReviewAssignment index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Duedate</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for review_assignment in review_assignments %}
            <tr>
                <td>{{ review_assignment.id }}</td>
                                <td>{{ review_assignment.submission.title }}</td>
<td>{{ review_assignment.reviewer }}</td>
                <td>{{ review_assignment.duedate ? review_assignment.duedate|date('Y-m-d H:i:s') : '' }}</td>
                <td nowrap-nowrap>
                    <a href="{{ path('review_assignment_show', {'id': review_assignment.id}) }}">show</a>
                    <a href="{{ path('review_assignment_edit', {'id': review_assignment.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
 
{% endblock %}
