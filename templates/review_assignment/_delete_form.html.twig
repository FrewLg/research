<form method="post" action="{{ path('unassign', {'id': review_assignment.id}) }}"
 onsubmit="return confirm('Are you sure you want to delete this item?');">

	<input type="hidden" name="_method" value="DELETE">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ review_assignment.id) }}">
	<button class="btn btn-warning btn-xs">
		Unassign
	</button>
                    <a href="{{ path('review_assignment_edit', {'id': review_assignment.id}) }}" class="btn btn-info btn-xs" >Edit</a>

	 <button type="button" class="btn btn-outline-primary btn-xs" data-bs-toggle="modal" data-bs-target="#showDetailsModal{{review_assignment.id}}">
									Details
								</button>


</form>
