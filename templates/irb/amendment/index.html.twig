{% extends 'base.html.twig' %}

{% block title %}Amendment {% endblock %}

{% block body %}
    <h1>Amendment </h1>

    <div class="card"><table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Purpose</th>
                <th>Changes</th>
                <th>Recruitment</th>
                <th>Procedures</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for amendment in amendments %}
            <tr>
                <td>{{ amendment.id }}</td>
                <td>{{ amendment.purpose }}</td>
                <td>{{ amendment.changes }}</td>
                <td>{{ amendment.recruitment }}</td>
                <td>{{ amendment.procedures }}</td>
                <td>
                    <a href="{{ path('i_r_b_amendment_show', {'id': amendment.id}) }}" class="btn btn-primary">show</a>
                    <a href="{{ path('i_r_b_amendment_edit', {'id': amendment.id}) }}" class="btn btn-warning">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

    <a href="{{ path('i_r_b_amendment_new') }}" class="btn btn-primary">Create new</a>
{% endblock %}
