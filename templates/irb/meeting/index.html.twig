{% extends 'base.html.twig' %}

{% block title %}Meetings{% endblock %}

{% block body %}
    <h1>Board Meeting History</h1>

    <a class="btn btn-primary float-end" href="{{ path('i_r_b_meeting_new') }}">Create new meeting</a>
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Number</th>
                <th>Meeting Date</th>
            </tr>
        </thead>
        <tbody>
        {% for meeting in meetings %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><a class="btn-link" href="{{ path('i_r_b_meeting_show', {'id': meeting.id}) }}">{{ meeting.number }}</a></td>
                <td>{{ meeting.heldAt ? meeting.heldAt|date('Y-m-d H:i:s') : '' }}</td>
              
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
