{% extends 'base.html.twig' %}

{% block title %}Research Subject Category {% endblock %}

{% block body %}
    <h1>Research Subject Category </h1>

    <div class="card p-1"><table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for research_subject_category in research_subject_categories %}
            <tr>
                <td>{{ research_subject_category.id }}</td>
                <td>{{ research_subject_category.name }}</td>
                <td>{{ research_subject_category.description }}</td>
                <td>
                    <a href="{{ path('i_r_b_research_subject_category_show', {'id': research_subject_category.id}) }}" class="btn btn-primary">show</a>
                    <a href="{{ path('i_r_b_research_subject_category_edit', {'id': research_subject_category.id}) }}" class="btn btn-warning">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>

    <a href="{{ path('i_r_b_research_subject_category_new') }}" class="btn btn-primary"><i class="fa fa-add"></i>Create new</a>
{% endblock %}
